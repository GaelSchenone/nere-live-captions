# Clave de la API de Gemini (para traduccion). Consiguela en https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# Modelo de Gemini usado solo para traducir texto (no audio)
TRANSLATION_MODEL=gemini-2.5-flash

# Config de faster-whisper (ASR local)
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_WORKERS=2

# Agresividad del VAD (0-3). Mas bajo = mas permisivo (clasifica mas cosas
# como voz -- util si el sistema "no toma nada" con audio limpio). Mas alto
# = mas estricto/selectivo (webrtcvad esta pensado para telefonia, y el modo
# 3 es el recomendado para ambientes ruidosos: rechaza mejor el ruido de
# fondo constante, a costa de poder recortar inicios de palabra muy suaves).
# Con mic de laptop con ruido de fondo o eco, probá primero con 3.
VAD_AGGRESSIVENESS=2

# Cuanto silencio (ms) corta un segmento y lo manda a transcribir. Bajarlo
# hace que los subtitulos aparezcan mas rapido pero corta frases mas seguido;
# subirlo espera pausas mas largas (mejor con eco, que deja "cola" de sonido
# despues de que la persona dejo de hablar).
VAD_SILENCE_MS=300

# Corte forzado (segundos) si alguien habla sin pausas naturales.
VAD_MAX_BUFFER_SECONDS=6.0

# Duracion minima (ms) de un segmento para mandarlo al motor. Segmentos mas
# cortos que esto se descartan sin transcribir -- sirve para filtrar blips
# de ruido o cola de eco que el VAD llega a marcar como "voz" por error.
VAD_MIN_SPEECH_MS=250

# Config de whisper.cpp (via pywhispercpp) -- motor local alternativo, otro
# backend de inferencia para comparar contra faster-whisper. Descarga el
# modelo ggml automaticamente la primera vez que se usa.
WHISPERCPP_MODEL=base
WHISPERCPP_THREADS=4

# Motor de transcripcion por defecto para sesiones nuevas (se puede elegir
# por sesion desde la UI): local_whisper | whispercpp | cloud_whisper | gemini_audio
DEFAULT_ASR_ENGINE=local_whisper

# Clave de la API de OpenAI, solo necesaria si usas el motor cloud_whisper.
# Conseguila en https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Modelo de OpenAI para el motor cloud_whisper (whisper-1 devuelve idioma
# detectado; gpt-4o-transcribe / gpt-4o-mini-transcribe son mas nuevos pero
# no devuelven idioma detectado)
CLOUD_WHISPER_MODEL=whisper-1

# Modelo de Gemini para el motor gemini_audio (envia el audio directo, sin
# pasar por whisper). Debe ser un modelo con soporte de audio de entrada.
GEMINI_AUDIO_MODEL=gemini-2.5-flash
